{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    header {
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }
    reverse_proxy app:3000
    # Access logs intentionally disabled: subscription paths contain read keys.
}
